# =============================================
# ANIKUMO — Environment Variables Example
# =============================================
# Copy this file to .env.local and fill in your values

# ---- App URL --------------------------------
# Your deployed Vercel URL (used for OAuth redirects)
NEXT_PUBLIC_APP_URL=

# ---- Auth Secret ----------------------------
# Run: openssl rand -base64 32
BETTER_AUTH_SECRET=your-random-secret-here

# ---- Turso Database -------------------------
# From: https://turso.tech/app
TURSO_URL=libsql://anivexa-xdking2.aws-us-west-2.turso.io
TURSO_TOKEN=eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9.eyJhIjoicnciLCJpYXQiOjE3ODAyMzA4MDEsImlkIjoiMDE5ZTdlMDUtYWEwMS03NWIyLWI0YjktNzc5ZmM2MTYwMTg2IiwicmlkIjoiNWI1ZTQzZDgtMTRhZi00MzNhLTlmYmYtNmU5OTVjMjRiNDQzIn0.8Cvxyk2HACXRLIHzJqLuXuffMpUqVA7A0efKfhGHWpCf3o3cvWrms4kgCvRunoUEEUQPgF7IjOlLiwUHMdqTCw

# ---- AniList OAuth --------------------------
# From: https://anilist.co/settings/developer
ANILIST_CLIENT_ID=42736
ANILIST_CLIENT_SECRET=your-anilist-client-secret
ANILIST_REDIRECT_URI=https://your-deployment.vercel.app/api/auth/anilist/callback

# ---- Google OAuth (Optional) ----------------
# From: https://console.cloud.google.com → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ---- GitHub OAuth (Optional) ----------------
# From: https://github.com/settings/developers → New OAuth App
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ---- Anime API (muriro-api) -----------------
# Source: https://github.com/dev-malvin/muriro-api
# No API key needed — just deploy and set the URL below
ANIME_API_URL=https://muriro-api.vercel.app

# ---- Manga API (manga-vault) ----------------
# Your deployed manga-vault URL
NEXT_PUBLIC_MANGA_API_URL=https://manga-vault-main.vercel.app

# ---- Streaming API (anikumo-api) ------------
# Your deployed anikumo-api URL
NEXT_PUBLIC_STREAM_API_URL=https://anikumo-api.vercel.app
